\documentclass[letterpaper,10pt]{article}
\usepackage[utf8]{inputenc}

%====================
% OFFICIAL PUBLIC OVERLEAF TEMPLATE
% https://www.overleaf.com/latex/templates/data-science-tech-resume-template/zcdmpfxrzjhv
%
%====================
%
% Resume template for data scientists, a complement to data-science-tech-cover-letter-template:
% https://www.overleaf.com/latex/templates/data-science-tech-cover-letter-template/gbrcqktbsfxf
%
% Files:        resume.tex: Main file
%               _header.tex: header code
%               TLCresume.sty: style file containing formatting details
%               section/objective: https://www.indeed.com/career-advice/resumes-cover-letters/resume-objective-examples
%               section/skills: table of skills
%               section/experience: projects or roles
%               section/education: schools and stuff
%               section/activities: optional, could comment out in resume.tex.
%
% Editor:       https://github.com/TimmyChan
%               https://www.linkedin.com/in/timmy-l-chan/
%
% Last Updated: March 24th, 2022
%
%====================


\usepackage{TLCresume}

%====================
% CONTACT INFORMATION
%====================
\def\name{\VAR{data.name | latex_escape}} % Name Here
\def\phone{\VAR{data.phone | format_phone}}
\def\city{\VAR{data.location | latex_escape}}
\def\email{\VAR{data.links.email | latex_escape}}
\def\LinkedIn{\VAR{data.links.linkedin | replace("https://www.linkedin.com/in/", "") | replace("/", "")}} % linkedin.com/in/______
\def\github{\VAR{data.links.github | replace("https://github.com/", "") | replace("/", "")}} % github username
\def\role{\VAR{data.resume_title | latex_escape}} % JOB TITLE

%====================
% Header: Contact
%====================

\RequirePackage{fancyhdr}
\fancypagestyle{fancy}{%
\fancyhf{}
\lhead{\phone \\ % PHONE
        \city \\ % city
	    \href{mailto:\email}{\email}} % EMAIL}
	\chead{%
	    \centering {\Huge \skills \name \vspace{.25em}} \\ % feel free to adjust vspace to 0
	    {\color{highlight} \Large{\role}}}%
	    \rhead{\bf{\VAR{data.citizenship}}\\ % Portfolio
	    \href{https://github.com/\github}{github.com/\github} \\% Github
	    \href{https://www.linkedin.com/in/\LinkedIn}{linkedin.com/in/\LinkedIn}} % LinkedIn
\renewcommand{\headrulewidth}{1pt}% 2pt header rule
\renewcommand{\headrule}{\hbox to\headwidth{%
  \color{highlight}\leaders\hrule height \headrulewidth\hfill}}
}
\pagestyle{fancy}

% Keep header/footer within the page so growing content cannot run below it.
\geometry{left=.25in,right=.25in,top=.25in,bottom=.3in,includeheadfoot,headheight=50pt,headsep=8pt,footskip=16pt}
\fancyfoot[C]{\small\color{highlight}\thepage}
\pagenumbering{arabic}
\DeclareUnicodeCharacter{2265}{\ensuremath{\geq}}
\setlength{\emergencystretch}{2em}
\pdfstringdefDisableCommands{\def\hfill{ }}
\hypersetup{pdftitle={\VAR{data.name | latex_escape} - Resume},pdfauthor={\VAR{data.name | latex_escape}}}

\begin{document}
%====================
% Objective Statement
%====================
\noindent
\VAR{data.about.objective | trim | latex_escape}

\BLOCK{for section in data.get("resume_section_order", ["education", "work", "skills", "research", "exams"])}
\BLOCK{if section == "education"}
\section{Education}
\BLOCK{for edu in data.education}
\BLOCK{if edu.gpa}
\resumeentryheading{{\VAR{edu.degree | latex_escape} (GPA: \VAR{edu.gpa})} | \textit{\VAR{edu.institution | latex_escape}} \hfill \VAR{edu.years}}
\BLOCK{else}
\resumeentryheading{{\VAR{edu.degree | latex_escape}} | \textit{\VAR{edu.institution | latex_escape}} \hfill \VAR{edu.years}}
\BLOCK{endif}
\BLOCK{if edu.coursework}
\begin{zitemize}
\item \normalfont Relevant Coursework: \VAR{edu.coursework | join(", ")}, etc.
\end{zitemize}
\BLOCK{endif}
\BLOCK{if not loop.last}

\BLOCK{endif}
\BLOCK{endfor}

\BLOCK{elif section == "work"}
\section{\VAR{data.get("resume_sections", {}).get("work", "Work Experience (By Project Per Organization)") | latex_escape}}
\BLOCK{for company in data.experience}
%====================
\BLOCK{if company.contracted_via}
\organizationheading{\VAR{company.company | latex_escape}}{\VAR{company.role | latex_escape} {\small(\VAR{company.industry | latex_escape}; Contracted via \VAR{company.contracted_via | latex_escape})}}{\VAR{company.years}}
\BLOCK{elif company.acquired_by}
\organizationheading{\VAR{company.company | latex_escape}}{\VAR{company.role | latex_escape} {\small(acquired by \VAR{company.acquired_by | latex_escape})}}{\VAR{company.years}}
\BLOCK{else}
\organizationheading{\VAR{company.company | latex_escape}}{\VAR{company.role | latex_escape} {\small(\VAR{company.industry | latex_escape})}}{\VAR{company.years}}
\BLOCK{endif}
\begin{organizationprojects}
\BLOCK{if company.description}
\noindent\textit{\VAR{company.description | trim | latex_escape}}\par\nobreak
\BLOCK{endif}
\BLOCK{for project in company.projects}
\projectheading{\VAR{project.name | latex_escape}}{\VAR{project.technologies | default([]) | join(", ") | latex_escape}}
\begin{zitemize}
\BLOCK{for highlight in project.highlights}
\item \VAR{highlight | trim | latex_inline}
\BLOCK{endfor}
\end{zitemize}
\BLOCK{if not loop.last}

\BLOCK{endif}
\BLOCK{endfor}
\end{organizationprojects}
\BLOCK{endfor}

\BLOCK{elif section == "skills"}
\section{Skills}
% Skill category names, order, and values all come from YAML.
\begin{tabular}{p{11em} p{1em} p{43em}}
\BLOCK{for category, items in data.skills.items()}
\skills{\VAR{category | latex_escape}} & & \VAR{items | join(", ") | latex_escape} \\
\BLOCK{endfor}
\end{tabular}


\BLOCK{elif section == "research"}
% Keep this short research section together when preceding content grows.
\begin{samepage}
\section{\VAR{data.get("resume_sections", {}).get("research", "Advanced Machine Learning Research") | latex_escape}}
\BLOCK{for item in data.research}
\resumeentryheading{{\VAR{item.name | latex_escape} {\normalfont\small(\VAR{item.technologies | join(", ") | latex_escape})}\BLOCK{if item.url} {\normalfont\small\href{\VAR{item.url}}{Code}}\BLOCK{endif} \hfill \VAR{item.period}}}
\begin{zitemize}
\BLOCK{if item.status}
\item \normalfont \VAR{item.description | trim | latex_inline} \bf{(\VAR{item.status | latex_escape})}
\BLOCK{else}
\item \normalfont \VAR{item.description | trim | latex_inline}
\BLOCK{endif}
\end{zitemize}

\BLOCK{if not loop.last}

\BLOCK{endif}
\BLOCK{endfor}

\end{samepage}

\BLOCK{elif section == "exams"}
\section{\VAR{data.get("resume_sections", {}).get("exams", "Actuarial Exams (Pre-Associateship in the Casualty Actuarial Society)") | latex_escape}}
\noindent
\BLOCK{for exam in data.actuarial_exams}
\BLOCK{if exam.note}
\VAR{exam.name | latex_escape} (\VAR{exam.note | latex_escape})
\BLOCK{else}
\VAR{exam.name | latex_escape}
\BLOCK{endif}
\BLOCK{if not loop.last} \textbullet{} \BLOCK{endif}
\BLOCK{endfor}

\BLOCK{endif}
\BLOCK{endfor}
\end{document}
