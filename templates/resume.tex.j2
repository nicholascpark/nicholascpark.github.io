\begin{zitemize}
\BLOCK{if item.status}
\item \normalfont \VAR{item.description | trim | latex_escape} \bf{(\VAR{item.status | latex_escape})}
\BLOCK{else}
\item \normalfont \VAR{item.description | trim | latex_escape}
\BLOCK{endif}
\end{zitemize}

\BLOCK{if not loop.last}

\BLOCK{endif}
\BLOCK{endfor}

\end{samepage}

