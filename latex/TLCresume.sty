\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{TLCresume}[11/19/21 resume package]
% Author: Timmy Chan

% Assuming using "article" document class and letter sized paper.
% FONT STUFF

\RequirePackage[T1]{fontenc} %  Font encoding https://texfaq.org/FAQ-why-inp-font
% Select the installed Source Sans family in T1 directly. The sourcesans
% wrapper also loads LY1, an unused encoding absent from BasicTeX.
\RequirePackage{mweights}
\renewcommand{\sfdefault}{SourceSansThree-TLF}
\renewcommand{\familydefault}{\sfdefault}
\def\mdseries@sf{regular}
\def\bfseries@sf{semibold}
\renewcommand{\seriesdefault}{regular}
\RequirePackage[10pt]{moresize}
\usepackage{anyfontsize}
\RequirePackage{csquotes}

% MARGINS AND SPACING
\RequirePackage[margin=.25in, top=.25in, bottom=0.25in]{geometry} % Set Margins
% \raggedright % left align no indent
\raggedbottom % top align no indent

% COLOR
\RequirePackage{xcolor}
\definecolor{highlight}{RGB}{61, 90, 128} % CHANGE THIS TO YOUR FAV COLOR https://g.co/kgs/aoqdi7

% LINKS
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,urlcolor=highlight}

% BULLET POINTS
\RequirePackage[inline]{enumitem}
\setlength{\tabcolsep}{0in}

% SECTION FORMATTING
\RequirePackage[nostruts]{titlesec}
\titlespacing*{\section}{0em}{0.5em}{0em}
\titleformat{\section}{\color{highlight} \scshape \raggedright \large}{}{0em}{}[\vspace{-0.75em}\hrulefill]
% SUBSECTION FORMATTING
\titlespacing*{\subsection}{0em}{0em}{0em}
\titleformat{\subsection}{\bfseries}{}{0em}{}[]

% BOLD COMMAND
\newcommand{\skills}[1]{ {\bfseries #1}}



% SUBTEXT
\newcommand{\subtext}[1]{\textit{#1}\par\vspace{-.75em}}

% tighter spacing than itemize
\setlist[itemize]{align=parleft,left=0pt..1em}
\newenvironment{zitemize}{
\begin{itemize} \itemsep 0pt \parskip 0pt \parsep 1pt}
{\end{itemize}\vspace{-.5em}}

% Organization/project hierarchy is presentation only; content comes from YAML.
\newcommand{\organizationheading}[3]{%
  \par\ifdim\dimexpr\pagegoal-\pagetotal\relax<5\baselineskip\newpage\fi
  \gdef\resume@organization{#1}%
  \addvspace{0.35em}%
  \noindent\begingroup\setlength{\fboxsep}{2pt}%
  \colorbox{highlight!10}{\parbox{\dimexpr\linewidth-2\fboxsep\relax}{%
    \textbf{\color{highlight}#1}\enspace\textbar\enspace#2\hfill\textbf{#3}}}%
  \endgroup\par\nobreak\vspace{0.15em}}
\newenvironment{organizationprojects}{%
  \begin{list}{}{\setlength{\leftmargin}{0.6em}\setlength{\rightmargin}{0pt}%
    \setlength{\topsep}{0pt}\setlength{\partopsep}{0pt}%
    \setlength{\parsep}{0pt}\setlength{\itemsep}{0pt}}\item\relax
}{\end{list}}
\newcommand{\projectheading}[2]{%
  % Reserve the title and the start of its evidence; carry ownership across pages.
  \par\ifdim\dimexpr\pagegoal-\pagetotal\relax<4\baselineskip
    \newpage
    \noindent{\small\color{highlight}\textbf{\resume@organization}\ (continued)}\par
    \nobreak\vspace{0.2em}%
  \fi
  \addvspace{0.2em}\noindent
  {\small\color{highlight}\textsc{Project:}}\enspace\textbf{\textit{#1}}%
  \if\relax\detokenize{#2}\relax\else\quad{\small\color{black!65}(#2)}\fi
  \par\nobreak\vspace{-0.65em}}

% NO PAGE NUMBER
\pagenumbering{gobble}

% SUBFILES IMPORTING
\RequirePackage{standalone}

% FOR TEMPLATE FILLER
\RequirePackage[english]{babel}
\RequirePackage{blindtext}% Filler Text
